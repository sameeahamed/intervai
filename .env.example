# Environment configuration example

# GEMINI_API_KEY: Required for Gemini AI API calls. Leave unset to use in-memory/demo mode without paid calls.
GEMINI_API_KEY=""

# AI_API_KEY: Alias for AI integration if using external proxy
AI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# MONGODB_URI: MongoDB connection string. Leave empty to run in in-memory-only mode.
MONGODB_URI=""

# DATABASE_URL: Optional fallback connection string
DATABASE_URL=""

# AUTH_SECRET: Secret used for signing authentication sessions and tokens
# For local development, an ephemeral secret will be used if this is empty or insecure.
AUTH_SECRET=""

# VOICE_PROVIDER: Modular voice provider (e.g., 'browser', 'gemini-tts', 'web-speech')
VOICE_PROVIDER="browser"

# Optional external TTS / STT service keys
TTS_API_KEY=""
STT_API_KEY=""

# NODE_ENV
NODE_ENV="development"

# Vite dev options
DISABLE_HMR=""

